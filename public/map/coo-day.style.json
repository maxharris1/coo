{
  "version": 8,
  "name": "Coo day",
  "metadata": {
    "coo:schema": "OpenMapTiles",
    "coo:source": "sources, glyphs and sprite copied from https://tiles.openfreemap.org/styles/liberty on 2026-11-21",
    "coo:editor": "Open in Maputnik to tune: https://maputnik.github.io/editor"
  },
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    }
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "sprite": "https://tiles.openfreemap.org/sprites/ofm_f384/ofm",
