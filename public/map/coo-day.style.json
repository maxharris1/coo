    {
      "id": "border",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "filter": [
        "all",
        [
          "==",
          [
            "typeof",
            [
              "get",
              "admin_level"
            ]
          ],
          "number"
        ],
        [
          ">=",
          [
            "get",
            "admin_level"
          ],
          2
        ],
        [
          "<=",
          [
            "get",
            "admin_level"
          ],
          4
        ],
        [
          "!=",
          [
            "get",
            "maritime"
          ],
          1
