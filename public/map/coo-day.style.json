        [
          "residential",
          "commercial",
          "retail",
          "industrial"
        ],
        true,
        false
      ],
      "paint": {
        "fill-color": "#E9E3D0"
      }
    },
    {
      "id": "green",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": [
        "match",
        [
          "get",
          "class"
        ],
        [
          "wood",
          "grass"
        ],
        true,
        false
      ],
      "paint": {
        "fill-color": "#86D9A0",
        "fill-opacity": 0.6
      }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
